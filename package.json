    "build:index": "node scripts/build-index.mjs",
    "prebuild": "node scripts/build-index.mjs",
    "typecheck": "tsc --noEmit",
    "zip": "node scripts/zip.mjs",
    "icons": "node scripts/icons.mjs"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.4.0",
    "@types/chrome": "^0.0.270",
    "typescript": "^5.5.0",
    "vite": "^7.3.3"
  },
  "overrides": {
    "rollup": "^4.22.4"
  }
